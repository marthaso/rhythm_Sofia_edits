% [y, x] = ind2sub(size(A), a);
% for pix = 1:5
%     [fig] = plot_examples_simple(data,y(pix),x(pix),AP_start_points{y(pix)...
%         ,x(pix)},AP_baselines{y(pix),x(pix)},AP_end_points{y(pix),x(pix)},AP_storage{y(pix),x(pix)},...
